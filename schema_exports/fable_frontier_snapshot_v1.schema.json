{
  "$defs": {
    "SourceWatermark": {
      "additionalProperties": false,
      "properties": {
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "operational_coverage": {
          "default": true,
          "title": "Operational Coverage",
          "type": "boolean"
        },
        "sequence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "event_time"
      ],
      "title": "SourceWatermark",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checkpoint_ids": {
      "items": {
        "format": "uuid7",
        "type": "string"
      },
      "title": "Checkpoint Ids",
      "type": "array"
    },
    "derived_at": {
      "format": "date-time",
      "title": "Derived At",
      "type": "string"
    },
    "enabled_node_ids": {
      "items": {
        "type": "string"
      },
      "title": "Enabled Node Ids",
      "type": "array"
    },
    "frontier_id": {
      "format": "uuid7",
      "title": "Frontier Id",
      "type": "string"
    },
    "graph_hash": {
      "minLength": 1,
      "title": "Graph Hash",
      "type": "string"
    },
    "hypothesis_id": {
      "format": "uuid7",
      "title": "Hypothesis Id",
      "type": "string"
    },
    "hypothesis_version": {
      "minimum": 0,
      "title": "Hypothesis Version",
      "type": "integer"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "fable.frontier_snapshot.v1",
      "default": "fable.frontier_snapshot.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_watermarks": {
      "additionalProperties": {
        "$ref": "#/$defs/SourceWatermark"
      },
      "title": "Source Watermarks",
      "type": "object"
    }
  },
  "required": [
    "request_id",
    "graph_hash",
    "hypothesis_id",
    "hypothesis_version",
    "enabled_node_ids",
    "checkpoint_ids"
  ],
  "title": "FrontierSnapshot",
  "type": "object"
}
