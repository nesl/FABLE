{
  "$defs": {
    "DeadlineSpec": {
      "additionalProperties": false,
      "description": "Processing-time usefulness boundary for one demand or hypothesis.",
      "properties": {
        "latest_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Start"
        },
        "latest_useful_completion": {
          "format": "date-time",
          "title": "Latest Useful Completion",
          "type": "string"
        }
      },
      "required": [
        "latest_useful_completion"
      ],
      "title": "DeadlineSpec",
      "type": "object"
    },
    "EntityBinding": {
      "additionalProperties": false,
      "properties": {
        "canonical_entity_id": {
          "minLength": 1,
          "title": "Canonical Entity Id",
          "type": "string"
        },
        "entity_type": {
          "minLength": 1,
          "title": "Entity Type",
          "type": "string"
        },
        "established_by_occurrence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Established By Occurrence Id"
        },
        "local_entity_ids": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Local Entity Ids",
          "type": "object"
        },
        "role_name": {
          "minLength": 1,
          "title": "Role Name",
          "type": "string"
        }
      },
      "required": [
        "role_name",
        "entity_type",
        "canonical_entity_id"
      ],
      "title": "EntityBinding",
      "type": "object"
    },
    "EventTimeInterval": {
      "additionalProperties": false,
      "description": "Closed event-time interval.\n\nInstantaneous observations use ``start == end``. All timestamps are\nnormalized to UTC at validation time.",
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "EventTimeInterval",
      "type": "object"
    },
    "HypothesisLifecycle": {
      "enum": [
        "ACTIVE",
        "FORKED",
        "MERGED",
        "COMPLETED",
        "INVALIDATED",
        "EXPIRED"
      ],
      "title": "HypothesisLifecycle",
      "type": "string"
    },
    "HypothesisNodeState": {
      "additionalProperties": false,
      "properties": {
        "event_time_intervals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EventTimeInterval"
          },
          "title": "Event Time Intervals",
          "type": "array"
        },
        "last_updated_at": {
          "format": "date-time",
          "title": "Last Updated At",
          "type": "string"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "occurrence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Occurrence Ids",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/HypothesisNodeStatus",
          "default": "UNRESOLVED"
        },
        "truth": {
          "$ref": "#/$defs/TruthValue",
          "default": "UNKNOWN"
        }
      },
      "required": [
        "node_id"
      ],
      "title": "HypothesisNodeState",
      "type": "object"
    },
    "HypothesisNodeStatus": {
      "enum": [
        "UNRESOLVED",
        "ENABLED",
        "PLANNED",
        "RUNNING",
        "SATISFIED",
        "FAILED",
        "INVALIDATED",
        "EXPIRED"
      ],
      "title": "HypothesisNodeStatus",
      "type": "string"
    },
    "TruthValue": {
      "enum": [
        "TRUE",
        "FALSE",
        "UNKNOWN"
      ],
      "title": "TruthValue",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "anchor_occurrence_id": {
      "minLength": 1,
      "title": "Anchor Occurrence Id",
      "type": "string"
    },
    "canonical_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Key"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "$ref": "#/$defs/DeadlineSpec"
    },
    "event_time_window": {
      "$ref": "#/$defs/EventTimeInterval"
    },
    "evidence_artifact_ids": {
      "default": [],
      "items": {
        "format": "uuid7",
        "type": "string"
      },
      "title": "Evidence Artifact Ids",
      "type": "array"
    },
    "frontier_id": {
      "anyOf": [
        {
          "format": "uuid7",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frontier Id"
    },
    "graph_hash": {
      "minLength": 1,
      "title": "Graph Hash",
      "type": "string"
    },
    "graph_id": {
      "minLength": 1,
      "title": "Graph Id",
      "type": "string"
    },
    "graph_version": {
      "minimum": 1,
      "title": "Graph Version",
      "type": "integer"
    },
    "hypothesis_id": {
      "format": "uuid7",
      "title": "Hypothesis Id",
      "type": "string"
    },
    "lifecycle": {
      "$ref": "#/$defs/HypothesisLifecycle",
      "default": "ACTIVE"
    },
    "node_states": {
      "additionalProperties": {
        "$ref": "#/$defs/HypothesisNodeState"
      },
      "title": "Node States",
      "type": "object"
    },
    "provenance_result_ids": {
      "default": [],
      "items": {
        "format": "uuid7",
        "type": "string"
      },
      "title": "Provenance Result Ids",
      "type": "array"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "role_bindings": {
      "additionalProperties": {
        "$ref": "#/$defs/EntityBinding"
      },
      "title": "Role Bindings",
      "type": "object"
    },
    "schema_version": {
      "const": "fable.hypothesis.v1",
      "default": "fable.hypothesis.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "structural_branch_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Structural Branch Ids",
      "type": "array"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "default": 0,
      "minimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "request_id",
    "graph_id",
    "graph_hash",
    "graph_version",
    "anchor_occurrence_id",
    "event_time_window",
    "deadline"
  ],
  "title": "Hypothesis",
  "type": "object"
}
