{
  "$defs": {
    "CheckpointKind": {
      "enum": [
        "PRIMITIVE",
        "OR_RESOLUTION",
        "AND_COMPLETION",
        "CARDINALITY",
        "WINDOW_CLOSURE"
      ],
      "title": "CheckpointKind",
      "type": "string"
    },
    "CheckpointStatus": {
      "enum": [
        "OPEN",
        "RESOLVED",
        "INVALIDATED",
        "EXPIRED"
      ],
      "title": "CheckpointStatus",
      "type": "string"
    },
    "EventTimeInterval": {
      "additionalProperties": false,
      "description": "Closed event-time interval.\n\nInstantaneous observations use ``start == end``. All timestamps are\nnormalized to UTC at validation time.",
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "EventTimeInterval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "branch_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Branch Ids",
      "type": "array"
    },
    "checkpoint_id": {
      "format": "uuid7",
      "title": "Checkpoint Id",
      "type": "string"
    },
    "event_time_interval": {
      "$ref": "#/$defs/EventTimeInterval"
    },
    "failure_activates_node_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Failure Activates Node Ids",
      "type": "array"
    },
    "hypothesis_id": {
      "format": "uuid7",
      "title": "Hypothesis Id",
      "type": "string"
    },
    "hypothesis_version": {
      "minimum": 0,
      "title": "Hypothesis Version",
      "type": "integer"
    },
    "kind": {
      "$ref": "#/$defs/CheckpointKind"
    },
    "node_ids": {
      "items": {
        "type": "string"
      },
      "title": "Node Ids",
      "type": "array"
    },
    "required_artifact_types_after_resolution": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Required Artifact Types After Resolution",
      "type": "array"
    },
    "schema_version": {
      "const": "fable.semantic_checkpoint.v1",
      "default": "fable.semantic_checkpoint.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CheckpointStatus",
      "default": "OPEN"
    },
    "success_activates_node_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Success Activates Node Ids",
      "type": "array"
    }
  },
  "required": [
    "hypothesis_id",
    "hypothesis_version",
    "kind",
    "node_ids",
    "event_time_interval"
  ],
  "title": "SemanticCheckpoint",
  "type": "object"
}
