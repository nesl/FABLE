{
  "$defs": {
    "ArtifactAccessMode": {
      "enum": [
        "LOCAL",
        "REMOTE_REFERENCE",
        "TRANSFERRED",
        "INLINE"
      ],
      "title": "ArtifactAccessMode",
      "type": "string"
    },
    "ArtifactLocation": {
      "additionalProperties": false,
      "properties": {
        "inline_data_base64": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inline Data Base64"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactLocationKind"
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Id"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ArtifactLocation",
      "type": "object"
    },
    "ArtifactLocationKind": {
      "enum": [
        "LOCAL_PATH",
        "OBJECT_URI",
        "REMOTE_REFERENCE",
        "INLINE"
      ],
      "title": "ArtifactLocationKind",
      "type": "string"
    },
    "ArtifactProducer": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version"
        },
        "provider_contract_version": {
          "minimum": 1,
          "title": "Provider Contract Version",
          "type": "integer"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "provider_contract_version"
      ],
      "title": "ArtifactProducer",
      "type": "object"
    },
    "EventTimeInterval": {
      "additionalProperties": false,
      "description": "Closed event-time interval.\n\nInstantaneous observations use ``start == end``. All timestamps are\nnormalized to UTC at validation time.",
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "EventTimeInterval",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "access_modes": {
      "items": {
        "$ref": "#/$defs/ArtifactAccessMode"
      },
      "title": "Access Modes",
      "type": "array"
    },
    "artifact_id": {
      "format": "uuid7",
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_schema_version": {
      "minLength": 1,
      "title": "Artifact Schema Version",
      "type": "string"
    },
    "artifact_type": {
      "minLength": 1,
      "title": "Artifact Type",
      "type": "string"
    },
    "bindings": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Bindings",
      "type": "object"
    },
    "bytes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bytes"
    },
    "checksum_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checksum Sha256"
    },
    "compatibility_keys": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Compatibility Keys",
      "type": "object"
    },
    "compatible_consumer_families": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Compatible Consumer Families",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "event_time_interval": {
      "$ref": "#/$defs/EventTimeInterval"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "location": {
      "$ref": "#/$defs/ArtifactLocation"
    },
    "policy_tags": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Policy Tags",
      "type": "array"
    },
    "producer": {
      "$ref": "#/$defs/ArtifactProducer"
    },
    "schema_version": {
      "const": "fable.artifact_ref.v1",
      "default": "fable.artifact_ref.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    }
  },
  "required": [
    "artifact_type",
    "artifact_schema_version",
    "producer",
    "event_time_interval",
    "location",
    "access_modes"
  ],
  "title": "ArtifactRef",
  "type": "object"
}
