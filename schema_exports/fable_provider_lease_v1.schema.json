{
  "$defs": {
    "ProviderLeaseStatus": {
      "enum": [
        "REQUESTED",
        "STARTING",
        "ACTIVE",
        "IDLE_LEASE",
        "DRAINING",
        "RELEASED",
        "FAILED",
        "EXPIRED"
      ],
      "title": "ProviderLeaseStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "format": "uuid7",
      "title": "Attempt Id",
      "type": "string"
    },
    "configuration_hash": {
      "minLength": 1,
      "title": "Configuration Hash",
      "type": "string"
    },
    "demand_id": {
      "format": "uuid7",
      "title": "Demand Id",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "lease_id": {
      "format": "uuid7",
      "title": "Lease Id",
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "title": "Node Id",
      "type": "string"
    },
    "plan_id": {
      "format": "uuid7",
      "title": "Plan Id",
      "type": "string"
    },
    "provider_contract_version": {
      "minimum": 1,
      "title": "Provider Contract Version",
      "type": "integer"
    },
    "provider_id": {
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "provider_instance_id": {
      "minLength": 1,
      "title": "Provider Instance Id",
      "type": "string"
    },
    "schema_version": {
      "const": "fable.provider_lease.v1",
      "default": "fable.provider_lease.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "starts_at": {
      "format": "date-time",
      "title": "Starts At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ProviderLeaseStatus",
      "default": "REQUESTED"
    }
  },
  "required": [
    "provider_instance_id",
    "provider_id",
    "provider_contract_version",
    "demand_id",
    "plan_id",
    "node_id",
    "configuration_hash",
    "starts_at",
    "expires_at"
  ],
  "title": "ProviderLease",
  "type": "object"
}
