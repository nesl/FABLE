{
  "$defs": {
    "JsonValue": {},
    "PlanStatus": {
      "enum": [
        "CANDIDATE",
        "ADMITTED",
        "RUNNING",
        "COMPLETED",
        "CANCELLED",
        "FAILED",
        "EXPIRED"
      ],
      "title": "PlanStatus",
      "type": "string"
    },
    "PlanStep": {
      "additionalProperties": false,
      "properties": {
        "depends_on_step_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Depends On Step Ids",
          "type": "array"
        },
        "estimated_execution_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Estimated Execution Ms",
          "type": "integer"
        },
        "estimated_startup_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Estimated Startup Ms",
          "type": "integer"
        },
        "estimated_transfer_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Estimated Transfer Bytes",
          "type": "integer"
        },
        "estimated_transfer_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Estimated Transfer Ms",
          "type": "integer"
        },
        "input_artifact_ids": {
          "default": [],
          "items": {
            "format": "uuid7",
            "type": "string"
          },
          "title": "Input Artifact Ids",
          "type": "array"
        },
        "input_data_types": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Data Types",
          "type": "array"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "output_data_types": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Output Data Types",
          "type": "array"
        },
        "parameters": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/JsonValue"
              }
            ],
            "type": "array"
          },
          "title": "Parameters",
          "type": "array"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "step_id": {
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "provider_id",
        "node_id"
      ],
      "title": "PlanStep",
      "type": "object"
    },
    "ResourceReservation": {
      "additionalProperties": false,
      "properties": {
        "cpu_cores": {
          "default": 0,
          "minimum": 0,
          "title": "Cpu Cores",
          "type": "number"
        },
        "gpu_memory_mb": {
          "default": 0,
          "minimum": 0,
          "title": "Gpu Memory Mb",
          "type": "integer"
        },
        "memory_mb": {
          "default": 0,
          "minimum": 0,
          "title": "Memory Mb",
          "type": "integer"
        },
        "network_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Network Bytes",
          "type": "integer"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "node_id"
      ],
      "title": "ResourceReservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checkpoint_id": {
      "format": "uuid7",
      "title": "Checkpoint Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "demand_ids": {
      "items": {
        "format": "uuid7",
        "type": "string"
      },
      "title": "Demand Ids",
      "type": "array"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "label_id": {
      "minLength": 1,
      "title": "Label Id",
      "type": "string"
    },
    "plan_id": {
      "format": "uuid7",
      "title": "Plan Id",
      "type": "string"
    },
    "reservations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResourceReservation"
      },
      "title": "Reservations",
      "type": "array"
    },
    "schema_version": {
      "const": "fable.execution_plan.v1",
      "default": "fable.execution_plan.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/PlanStatus",
      "default": "CANDIDATE"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/PlanStep"
      },
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "label_id",
    "checkpoint_id",
    "demand_ids",
    "steps"
  ],
  "title": "ExecutionPlan",
  "type": "object"
}
