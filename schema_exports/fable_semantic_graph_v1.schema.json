{
  "$defs": {
    "GraphEdge": {
      "additionalProperties": false,
      "properties": {
        "branch_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch Label"
        },
        "edge_id": {
          "minLength": 1,
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GraphEdgeKind"
        },
        "source_node_id": {
          "minLength": 1,
          "title": "Source Node Id",
          "type": "string"
        },
        "target_node_id": {
          "minLength": 1,
          "title": "Target Node Id",
          "type": "string"
        },
        "temporal_guard_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Temporal Guard Ids",
          "type": "array"
        }
      },
      "required": [
        "edge_id",
        "source_node_id",
        "target_node_id",
        "kind"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphEdgeKind": {
      "enum": [
        "SEQUENCE",
        "DEPENDS_ON",
        "CHILD",
        "ALTERNATIVE"
      ],
      "title": "GraphEdgeKind",
      "type": "string"
    },
    "GraphNode": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Annotations",
          "type": "object"
        },
        "authored_key": {
          "minLength": 1,
          "title": "Authored Key",
          "type": "string"
        },
        "checkpoint_boundary": {
          "default": false,
          "title": "Checkpoint Boundary",
          "type": "boolean"
        },
        "k": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "K"
        },
        "kind": {
          "$ref": "#/$defs/GraphNodeKind"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "predicate": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticPredicate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "node_id",
        "authored_key",
        "kind",
        "name"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "GraphNodeKind": {
      "enum": [
        "PREDICATE",
        "AND",
        "OR",
        "K_OF_N",
        "DURATION",
        "ABSENT",
        "WITHIN",
        "NAMED_SUBGRAPH"
      ],
      "title": "GraphNodeKind",
      "type": "string"
    },
    "JsonValue": {},
    "PredicateRole": {
      "additionalProperties": false,
      "properties": {
        "entity_type": {
          "minLength": 1,
          "title": "Entity Type",
          "type": "string"
        },
        "role_name": {
          "minLength": 1,
          "title": "Role Name",
          "type": "string"
        },
        "variable": {
          "minLength": 1,
          "title": "Variable",
          "type": "string"
        }
      },
      "required": [
        "role_name",
        "variable",
        "entity_type"
      ],
      "title": "PredicateRole",
      "type": "object"
    },
    "ResultKind": {
      "enum": [
        "INSTANT_MATCH",
        "INTERVAL_MATCH",
        "STATE_OBSERVATION",
        "GROUP_MATCH",
        "ARTIFACT_ONLY"
      ],
      "title": "ResultKind",
      "type": "string"
    },
    "RoleDefinition": {
      "additionalProperties": false,
      "properties": {
        "cardinality_max": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "title": "Cardinality Max"
        },
        "cardinality_min": {
          "default": 1,
          "minimum": 0,
          "title": "Cardinality Min",
          "type": "integer"
        },
        "distinct_from": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Distinct From",
          "type": "array"
        },
        "entity_type": {
          "minLength": 1,
          "title": "Entity Type",
          "type": "string"
        },
        "role_name": {
          "minLength": 1,
          "title": "Role Name",
          "type": "string"
        }
      },
      "required": [
        "role_name",
        "entity_type"
      ],
      "title": "RoleDefinition",
      "type": "object"
    },
    "SemanticPredicate": {
      "additionalProperties": false,
      "description": "Provider-independent semantic condition.",
      "properties": {
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "predicate_id": {
          "minLength": 1,
          "title": "Predicate Id",
          "type": "string"
        },
        "result_kind": {
          "$ref": "#/$defs/ResultKind"
        },
        "roles": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PredicateRole"
          },
          "title": "Roles",
          "type": "array"
        }
      },
      "required": [
        "predicate_id",
        "result_kind"
      ],
      "title": "SemanticPredicate",
      "type": "object"
    },
    "TemporalGuard": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "guard_id": {
          "minLength": 1,
          "title": "Guard Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TemporalGuardKind"
        },
        "maximum_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Ms"
        },
        "minimum_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Ms"
        },
        "required_source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Source Ids",
          "type": "array"
        },
        "source_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Node Ids",
          "type": "array"
        },
        "target_node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Node Id"
        }
      },
      "required": [
        "guard_id",
        "kind",
        "source_node_ids"
      ],
      "title": "TemporalGuard",
      "type": "object"
    },
    "TemporalGuardKind": {
      "enum": [
        "WITHIN",
        "DURATION",
        "ABSENCE_WINDOW",
        "PRECEDES",
        "OVERLAPS",
        "MAX_GAP",
        "REPEAT_WITHIN"
      ],
      "title": "TemporalGuardKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authored_variant_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Authored Variant Ids",
      "type": "array"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "edges": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GraphEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "graph_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Graph Hash",
      "type": "string"
    },
    "graph_id": {
      "minLength": 1,
      "title": "Graph Id",
      "type": "string"
    },
    "graph_version": {
      "default": 1,
      "minimum": 1,
      "title": "Graph Version",
      "type": "integer"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/GraphNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "roles": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RoleDefinition"
      },
      "title": "Roles",
      "type": "array"
    },
    "root_node_id": {
      "minLength": 1,
      "title": "Root Node Id",
      "type": "string"
    },
    "schema_version": {
      "const": "fable.semantic_graph.v1",
      "default": "fable.semantic_graph.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "temporal_guards": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TemporalGuard"
      },
      "title": "Temporal Guards",
      "type": "array"
    }
  },
  "required": [
    "graph_id",
    "graph_hash",
    "name",
    "root_node_id",
    "nodes"
  ],
  "title": "SemanticGraph",
  "type": "object"
}
