#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON="$ROOT/.venv/bin/python"

if [[ ! -x "$PYTHON" ]]; then
  echo "FABLE is not installed. Run: python -m venv .venv && .venv/bin/pip install -e ." >&2
  exit 1
fi

exec "$PYTHON" -m scripts.run_experiment "$@"
