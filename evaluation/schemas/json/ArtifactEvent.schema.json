{
  "$defs": {
    "BaselineId": {
      "enum": [
        "B0_ALWAYS_ON",
        "B1_HANDWRITTEN_STATIC",
        "B2_STATIC_WHOLE_EVENT",
        "B3_TASK_RESOURCE_ADAPTIVE",
        "B4_GREEDY_FRONTIER",
        "FABLE",
        "O1_EXHAUSTIVE_ORACLE",
        "SPATIAL_BROADCAST",
        "SPATIAL_TOPOLOGY_SHORTLIST",
        "SPATIAL_RESOURCE_ONLY",
        "SPATIAL_FABLE",
        "SPATIAL_ORACLE"
      ],
      "title": "BaselineId",
      "type": "string"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "fable.evaluation_record.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "record_type": {
      "const": "artifact_event",
      "default": "artifact_event",
      "title": "Record Type",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "baseline_id": {
      "$ref": "#/$defs/BaselineId"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "hypothesis_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hypothesis Id"
    },
    "sensor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sensor Id"
    },
    "provider_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Id"
    },
    "event_time": {
      "format": "date-time",
      "title": "Event Time",
      "type": "string"
    },
    "monotonic_timestamp_ns": {
      "minimum": 0,
      "title": "Monotonic Timestamp Ns",
      "type": "integer"
    },
    "wall_timestamp": {
      "format": "date-time",
      "title": "Wall Timestamp",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "artifact_id": {
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "minLength": 1,
      "title": "Artifact Type",
      "type": "string"
    },
    "action": {
      "minLength": 1,
      "title": "Action",
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "title": "Node Id",
      "type": "string"
    },
    "bytes": {
      "default": 0,
      "minimum": 0,
      "title": "Bytes",
      "type": "integer"
    },
    "access_mode": {
      "default": "",
      "title": "Access Mode",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "bindings": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Bindings",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "baseline_id",
    "trace_id",
    "request_id",
    "event_time",
    "monotonic_timestamp_ns",
    "artifact_id",
    "artifact_type",
    "action",
    "node_id"
  ],
  "title": "ArtifactEvent",
  "type": "object"
}