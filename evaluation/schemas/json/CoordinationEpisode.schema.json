{
  "$defs": {
    "BaselineId": {
      "enum": [
        "B0_ALWAYS_ON",
        "B1_HANDWRITTEN_STATIC",
        "B2_STATIC_WHOLE_EVENT",
        "B3_TASK_RESOURCE_ADAPTIVE",
        "B4_GREEDY_FRONTIER",
        "FABLE",
        "O1_EXHAUSTIVE_ORACLE",
        "SPATIAL_BROADCAST",
        "SPATIAL_TOPOLOGY_SHORTLIST",
        "SPATIAL_RESOURCE_ONLY",
        "SPATIAL_FABLE",
        "SPATIAL_ORACLE"
      ],
      "title": "BaselineId",
      "type": "string"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "fable.evaluation_record.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "record_type": {
      "const": "coordination_episode",
      "default": "coordination_episode",
      "title": "Record Type",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "baseline_id": {
      "$ref": "#/$defs/BaselineId"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "hypothesis_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hypothesis Id"
    },
    "sensor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sensor Id"
    },
    "provider_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Id"
    },
    "event_time": {
      "format": "date-time",
      "title": "Event Time",
      "type": "string"
    },
    "monotonic_timestamp_ns": {
      "minimum": 0,
      "title": "Monotonic Timestamp Ns",
      "type": "integer"
    },
    "wall_timestamp": {
      "format": "date-time",
      "title": "Wall Timestamp",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "episode_id": {
      "minLength": 1,
      "title": "Episode Id",
      "type": "string"
    },
    "campaign_year": {
      "title": "Campaign Year",
      "type": "integer"
    },
    "spatial_evaluation_eligible": {
      "title": "Spatial Evaluation Eligible",
      "type": "boolean"
    },
    "upstream_sensor_id": {
      "minLength": 1,
      "title": "Upstream Sensor Id",
      "type": "string"
    },
    "object_binding": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Object Binding"
    },
    "predicted_sensor_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Predicted Sensor Ids",
      "type": "array"
    },
    "activated_sensor_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Activated Sensor Ids",
      "type": "array"
    },
    "replay_supported_sensor_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Replay Supported Sensor Ids",
      "type": "array"
    },
    "unavailable_mobile_sensor_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unavailable Mobile Sensor Ids",
      "type": "array"
    },
    "actual_downstream_sensor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actual Downstream Sensor Id"
    },
    "prediction_time": {
      "format": "date-time",
      "title": "Prediction Time",
      "type": "string"
    },
    "downstream_observation_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Downstream Observation Time"
    },
    "deadline": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline"
    },
    "topology_confidence": {
      "default": "",
      "title": "Topology Confidence",
      "type": "string"
    },
    "route_ambiguity": {
      "default": 1,
      "minimum": 1,
      "title": "Route Ambiguity",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "baseline_id",
    "trace_id",
    "request_id",
    "event_time",
    "monotonic_timestamp_ns",
    "episode_id",
    "campaign_year",
    "spatial_evaluation_eligible",
    "upstream_sensor_id",
    "prediction_time"
  ],
  "title": "CoordinationEpisode",
  "type": "object"
}