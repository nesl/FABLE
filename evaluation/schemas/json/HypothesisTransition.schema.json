{
  "$defs": {
    "BaselineId": {
      "enum": [
        "B0_ALWAYS_ON",
        "B1_HANDWRITTEN_STATIC",
        "B2_STATIC_WHOLE_EVENT",
        "B3_TASK_RESOURCE_ADAPTIVE",
        "B4_GREEDY_FRONTIER",
        "FABLE",
        "O1_EXHAUSTIVE_ORACLE",
        "SPATIAL_BROADCAST",
        "SPATIAL_TOPOLOGY_SHORTLIST",
        "SPATIAL_RESOURCE_ONLY",
        "SPATIAL_FABLE",
        "SPATIAL_ORACLE"
      ],
      "title": "BaselineId",
      "type": "string"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "fable.evaluation_record.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "record_type": {
      "const": "hypothesis_transition",
      "default": "hypothesis_transition",
      "title": "Record Type",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "baseline_id": {
      "$ref": "#/$defs/BaselineId"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "hypothesis_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hypothesis Id"
    },
    "sensor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sensor Id"
    },
    "provider_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Id"
    },
    "event_time": {
      "format": "date-time",
      "title": "Event Time",
      "type": "string"
    },
    "monotonic_timestamp_ns": {
      "minimum": 0,
      "title": "Monotonic Timestamp Ns",
      "type": "integer"
    },
    "wall_timestamp": {
      "format": "date-time",
      "title": "Wall Timestamp",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "graph_version": {
      "minimum": 1,
      "title": "Graph Version",
      "type": "integer"
    },
    "previous_state": {
      "minLength": 1,
      "title": "Previous State",
      "type": "string"
    },
    "next_state": {
      "minLength": 1,
      "title": "Next State",
      "type": "string"
    },
    "transition_kind": {
      "minLength": 1,
      "title": "Transition Kind",
      "type": "string"
    },
    "graph_node_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Graph Node Ids",
      "type": "array"
    },
    "bindings_before": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Bindings Before",
      "type": "object"
    },
    "bindings_after": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Bindings After",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "baseline_id",
    "trace_id",
    "request_id",
    "event_time",
    "monotonic_timestamp_ns",
    "graph_version",
    "previous_state",
    "next_state",
    "transition_kind"
  ],
  "title": "HypothesisTransition",
  "type": "object"
}