{
  "schema_version": "1.0",
  "model_name": "West Point qualitative sensor transition model",
  "model_type": "qualitative_topology_not_calibrated_geometry",
  "coordinate_frame": {
    "origin": "approximately the center of the map grid",
    "x_axis": "positive values point east/right",
    "y_axis": "positive values point north/up",
    "units": "approximate map-grid units read from the diagrams",
    "heading_convention": {
      "N": "up",
      "E": "right",
      "S": "down",
      "W": "left"
    }
  },
  "assumptions": [
    "All fixed and selected mobile nodes are available.",
    "Blue sectors are approximate fixed-camera fields of view.",
    "White sectors/arrows are approximate mobile-camera fields of view.",
    "All nodes have microphones, but this model predicts camera handoffs only.",
    "Audio range and obstruction are not inferable from the diagrams and require calibration.",
    "Observation groups may overlap; sensors in the same group may see an object nearly simultaneously.",
    "Scenario letters such as A and B are local aliases and are not stable site coordinates.",
    "Container walls and moving-object occlusion are not modeled."
  ],
  "confidence_scale": {
    "high": "directly supported by a clearly drawn route crossing a field of view",
    "medium": "supported by approximate overlap or multiple diagrams",
    "low": "plausible adjacency but should be calibrated before operational use"
  },
